// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Tests, lint and docs",
            "command": "tox -p",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "problemMatcher": [],
        },
        {
            "type": "shell",
            "label": "kubectl port-forward",
            "command": "kubectl",
            "args": [
                "port-forward",
                "-n",
                "${input:namespace}",
                "${input:pod}",
                "5678",
                "&"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "namespace",
            "type": "promptString",
            "description": "Beamline namespace in the cluster",
            "default": "ixx-beamline"
        },
        {
            "id": "pod",
            "type": "promptString",
            "description": "Blueapi pod name",
            "default": "ixx-blueapi-0",
        }
    ]
}
